# Defaults for make. Copy to .env; variables given on the make command line win.
# Plain KEY=value lines, no quotes: make reads this file, not a shell.

HOST=ubuntu
SRC=~/IdeaProjects/cassandra
JDK=17
# cassandra-dtest checkout; empty means <SRC>/../cassandra-dtest, cloned there if missing
DTEST=~/IdeaProjects/cassandra-dtest
# fewest test classes a free slot takes from a job that runs in parts; empty means 10
MIN_CLASSES_PER_PART=10
